{
	"name": "agent-backend",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"start": "tsx --env-file-if-exists=.env src/server.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"smoke": "tsx scripts/smoke.ts",
		"check": "npm run lint && npm run typecheck && npm test"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "1.8.0",
		"@fastify/swagger": "9.9.3",
		"@fastify/swagger-ui": "6.1.3",
		"fastify": "5.12.8",
		"fastify-type-provider-zod": "7.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@types/node": "22.20.5",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
